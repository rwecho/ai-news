---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const sitePath = (path = '') => `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}${path.replace(/^\//, '')}`;
const isPublic = (post) => ['ready', 'published'].includes(post.data.status ?? 'draft');
const posts = (await getCollection('news')).filter(isPublic).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base>
  <section class="home-intro">
    <div class="eyebrow">百法难治 / AI FIELD NOTES</div>
    <h1>把 AI 的变化，<br /><em>写成值得留下的记录。</em></h1>
    <p>不追着热搜重复消息，只把产品、模型和真实使用中的变化拆开来看。</p>
  </section>

  <section class="section-block article-index">
    <div class="section-head">
      <h2>最新文章</h2>
      <span>{String(posts.length).padStart(2, '0')} 篇记录</span>
    </div>

    <div class="post-list">
      {posts.map((post, index) => (
        <a class="post-row" href={sitePath(`news/${post.data.slug}/`)}>
          <div class="post-index">{String(index + 1).padStart(2, '0')}</div>
          <div class="post-copy">
            <div class="post-meta">
              <span>{post.data.tags[0] ?? 'AI'}</span>
              <time>{post.data.date.toLocaleDateString('zh-CN')}</time>
            </div>
            <h3>{post.data.title}</h3>
            <p>{post.data.summary}</p>
          </div>
          <span class="arrow" aria-hidden="true">↗</span>
        </a>
      ))}
      {posts.length === 0 && <p class="empty">下一篇正在路上。</p>}
    </div>
  </section>

  <section class="principles">
    <span class="eyebrow">编辑标准</span>
    <p>先看证据，再下判断。能确认的地方说清楚，不能确认的地方直接标出来。</p>
  </section>
</Base>
