---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ArticleCover from '../components/ArticleCover.astro';

const sitePath = (path = '') => `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}${path.replace(/^\//, '')}`;
const posts = (await getCollection('news')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = posts[0];
const rest = posts.slice(1);
---

<Base>
  <section class="hero-shell">
    <div class="eyebrow">百法难治 / AI 观察</div>
    <h1>我不负责把 AI 说得神奇，<br /><em>只负责把它讲明白。</em></h1>
    <p class="hero-copy">从创作者的测试、评论区的争论和真正能复现的细节出发，写一点不急着下结论的 AI 观察。</p>
  </section>

  {featured && (
    <a class="featured-card" href={sitePath(`news/${featured.data.slug}/`)}>
      <div class="featured-copy">
        <div class="featured-meta"><span>最新文章</span><time>{featured.data.date.toLocaleDateString('zh-CN')}</time></div>
        <h2>{featured.data.title}</h2>
        <p>{featured.data.summary}</p>
        <span class="read-link">阅读全文 <span>↗</span></span>
      </div>
      <div class="featured-media"><ArticleCover post={featured} /></div>
    </a>
  )}

  <section class="section-block">
    <div class="section-head"><h2>最近写的</h2><span>{posts.length} 篇记录</span></div>
    <div class="post-list">
      {rest.map((post) => (
        <a class="post-row" href={sitePath(`news/${post.data.slug}/`)}>
          <div class="post-copy">
            <time>{post.data.date.toLocaleDateString('zh-CN')}</time>
            <h3>{post.data.title}</h3>
            <p>{post.data.summary}</p>
          </div>
          <ArticleCover post={post} compact />
          <span class="arrow">↗</span>
        </a>
      ))}
      {rest.length === 0 && <p class="empty">下一篇正在路上。</p>}
    </div>
  </section>

  <section class="principles">
    <span class="eyebrow">写作原则</span>
    <p>先看证据，再下判断。能说清楚的地方说清楚，不能确认的地方就直接承认。</p>
  </section>
</Base>
