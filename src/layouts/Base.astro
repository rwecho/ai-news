---
import '../styles/global.css';
const { title = '百法难治 AI', description = '把 AI 新闻讲成人话。' } = Astro.props;
const basePath = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const sitePath = (path = '') => `${basePath}${path.replace(/^\//, '')}`;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" href={sitePath('favicon.svg')} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={sitePath()}>
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 32 32" role="img">
            <path d="M7 7h18M10 11h12v14H10zM10 16h12" />
            <path class="brand-mark-accent" d="M22 11v14" />
          </svg>
        </span>
        <span><strong>百法难治</strong><small>AI FIELD NOTES</small></span>
      </a>
      <nav>
        <a class:list-active={path === sitePath()} href={sitePath()}>首页</a>
        <a class:list-active={path.startsWith(sitePath('tags/'))} href={sitePath('tags/')}>标签</a>
        <a href="https://github.com/rwecho/ai-news">GitHub ↗</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <span>不追热点的热闹，只追消息背后的东西。</span>
      <span>© 2026 百法难治</span>
    </footer>
  </body>
</html>
