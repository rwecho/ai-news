---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
const basePath = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const sitePath = (path = '') => `${basePath}${path.replace(/^\//, '')}`;
const posts = await getCollection('news');
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
---
<Base title="标签 · 百法难治 AI">
  <section class="simple-page">
    <div class="eyebrow">BROWSE TAGS</div>
    <h1>按标签找</h1>
    <div class="tag-cloud">{tags.map((tag) => <a href={`#${tag}`}>#{tag}</a>)}</div>
    {tags.map((tag) => <section class="tag-section" id={tag}><h2>#{tag}</h2>{posts.filter((p) => p.data.tags.includes(tag)).map((p) => <a href={sitePath(`news/${p.data.slug}/`)}>{p.data.title}</a>)}</section>)}
  </section>
</Base>
